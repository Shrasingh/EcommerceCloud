# ─────────────────────────────────────────────────────────────
# EcommerceCloud (Admin Dashboard) — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# ── Clerk authentication ── (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ── Database (PostgreSQL) ──
# Neon (recommended): https://neon.tech  — use the pooled connection string.
# IMPORTANT: URL-encode special characters in the password (e.g. `@` -> `%40`).
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
# Direct (non-pooled) connection — used by Prisma migrations. For Neon use the
# same host without `-pooler`, or reuse DATABASE_URL if you have no pooled URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# ── Cloudinary (image uploads) ── (https://cloudinary.com)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your_cloud_name"
# Name of an *unsigned* upload preset (Cloudinary > Settings > Upload) in YOUR
# account. There is no default: when unset, image uploads are disabled in the
# admin. Restrict the preset in Cloudinary (folder, formats, max size).
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# ── Stripe (payments) ── (https://dashboard.stripe.com/test/apikeys)
STRIPE_API_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# ── Storefront URL ── (where QuickCart runs; used for Stripe redirect URLs and
# as the only browser origin allowed to call /checkout). Set a DIFFERENT value
# in each Vercel environment (Preview vs Production); never share production's.
FRONTEND_STORE_URL=http://localhost:3001
# Optional: extra storefront origins (comma-separated, scheme + host only) that
# may call /checkout and be redirected back to, e.g. a fixed Preview alias.
# A checkout started from an origin that is not listed is refused (403).
# ALLOWED_STOREFRONT_ORIGINS=https://quick-cart-staging.vercel.app

# ── Seed script (optional) ──
# Set this to your Clerk user id so the seeded demo store shows up in the
# admin dashboard for your account. Find it in the Clerk dashboard > Users.
# Required: without it the seed refuses to run, unless you explicitly allow a
# placeholder owner (a store nobody can manage) with SEED_ALLOW_PLACEHOLDER_OWNER=1.
SEED_STORE_OWNER_ID=

# Optional: set to 1 to run the seed over Neon's WebSocket driver (port 443)
# on networks that drop direct Postgres connections. Not used by the app.
# SEED_NEON_WS=1

# Required to seed a database that already has stores (the seed deletes ALL
# data). Must equal the host in DATABASE_URL. Leave unset normally.
# SEED_CONFIRM_WIPE=
